# Plantilla del .env del backend. Copiar a .env (cp .env.example .env) y llenar.
# Las variables del módulo de pagos están documentadas en .env.payments.example.
# Nunca commitear el .env ni la llave de servicio de Firebase.

# Django. Generar una clave propia:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambiar_por_una_clave_aleatoria
DEBUG=True
# Emulador Android: agregar 10.0.2.2; teléfono físico: la IP del PC en la red local
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Origen del panel admin (Vite corre en el puerto 3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Firebase: llave de cuenta de servicio (Consola de Firebase > Configuración del
# proyecto > Cuentas de servicio > Generar nueva clave privada), guardada en backend/
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_DATABASE_URL=https://<proyecto>-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=<proyecto>.firebasestorage.app

# development | production
DJANGO_ENV=development

# Pagos (ver .env.payments.example)
PAGOS_MODO=mock
MOCK_EVENTS_SECRET=mock_events_cambiar_por_valor_aleatorio
MOCK_INTEGRITY_SECRET=mock_integrity_cambiar_por_valor_aleatorio
MOCK_CHECKOUT_BASE_URL=http://localhost:8000
