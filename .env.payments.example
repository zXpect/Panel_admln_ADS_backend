# ==================== PAGOS ====================
# Plantilla de variables del módulo de pagos. Copiar a .env con valores reales.
# Nunca commitear llaves reales de Wompi.

# development | production. Con production, PAGOS_MODO=mock impide arrancar el backend.
DJANGO_ENV=development

# mock | wompi
PAGOS_MODO=mock

# Pasarela simulada (solo desarrollo). Generar valores aleatorios propios, p. ej.:
#   python -c "import secrets; print(secrets.token_hex(24))"
MOCK_EVENTS_SECRET=mock_events_cambiar_por_valor_aleatorio
MOCK_INTEGRITY_SECRET=mock_integrity_cambiar_por_valor_aleatorio

# Wompi (Fase 7). Sandbox: pub_test_ / prv_test_ / test_events_ / test_integrity_
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
