# ===========================================
# CONFIGURACIÓN DE PRODUCCIÓN - RENDER (D23)
# ===========================================
# En Render estas variables se definen en el panel del servicio (o vienen de
# render.yaml); este archivo solo documenta cuáles hacen falta. Nunca
# commitear valores reales.

# Django
DJANGO_ENV=production
DEBUG=False
# Render la genera (generateValue en render.yaml)
SECRET_KEY=genera-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=ads-api.onrender.com
CSRF_TRUSTED_ORIGINS=https://ads-api.onrender.com
# URL del panel admin (React)
CORS_ALLOWED_ORIGINS=https://tu-panel.example.com

# PostgreSQL: Render la inyecta desde la base ads-db
DATABASE_URL=postgres://usuario:clave@host:5432/ads

# Firebase: subir serviceAccountKey.json como Secret File en Render
FIREBASE_CREDENTIALS_PATH=/etc/secrets/serviceAccountKey.json
FIREBASE_DATABASE_URL=https://tu-proyecto.firebaseio.com
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com

# Pagos: en producción solo wompi (con mock el backend no arranca)
PAGOS_MODO=wompi
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
