# ===========================================
# CONFIGURACIÓN DE PRODUCCIÓN - AWS EC2
# ===========================================
# Copia este archivo como .env en el servidor

# Django Settings
DJANGO_ENV=production
SECRET_KEY=genera-una-clave-secreta-segura-aqui
DEBUG=False

# Hosts permitidos (reemplaza con tu IP/dominio de EC2)
ALLOWED_HOSTS=ec2-XX-XX-XX-XX.compute-1.amazonaws.com,XX.XX.XX.XX

# CORS - URL del frontend en CloudFront
CORS_ALLOWED_ORIGINS=https://dXXXXXXX.cloudfront.net

# Firebase Configuration
FIREBASE_CREDENTIALS_PATH=/var/www/backend/firebase-credentials.json
FIREBASE_DATABASE_URL=https://tu-proyecto.firebaseio.com
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
