{
  "name": "ads-firebase-rules",
  "private": true,
  "description": "Reglas de Firebase de ADS y sus pruebas con el emulador",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only database,storage --project demo-ads \"node --test --test-concurrency=1 tests/*.test.mjs\"",
    "test:stage1": "firebase emulators:exec --only database --project demo-ads \"node --test --test-concurrency=1 tests/database.rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1"
  }
}
